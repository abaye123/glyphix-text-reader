<template>
  <scroll class="page">
    <div class="top-space"></div>
    <div class="field">
      <text if="{{query}}" class="query">{{query}}</text>
      <text if="{{!query}}" class="hint">{{hint}}</text>
    </div>
    <div if="{{keys}}" class="keys">
      <div for="r in keyRows" class="key-row">
        <div for="k in r.keys" class="key" on:click="press(k)">
          <text class="key-text">{{k}}</text>
        </div>
      </div>
      <div class="key-row">
        <div class="wide-key" on:click="backspace"><text class="wide-text">מחק</text></div>
        <div class="wide-key" on:click="clear"><text class="wide-text">נקה</text></div>
        <div class="wide-key" on:click="press(' ')"><text class="wide-text">רווח</text></div>
        <div class="wide-key toggle-key" on:click="switchLayout"><text class="wide-text">{{toggleText}}</text></div>
      </div>
      <div class="go" on:click="run"><text class="go-text">חפש</text></div>
    </div>
    <div if="{{!keys}}" class="go" on:click="stopOrEdit"><text class="go-text">{{editText}}</text></div>
    <text if="{{countText}}" class="count">{{countText}}</text>
    <div for="row in results" class="slot">
      <div class="row" on:click="tap(row.i)">
        <text class="label">{{row.text}}</text>
        <text class="sub">{{row.name}}</text>
      </div>
    </div>
    <div class="bottom-space"></div>
  </scroll>
</template>

<style>
  .page {
    width: 466px;
    height: 466px;
    background-color: #000000;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .top-space { width: 10px; height: 44px; }
  .bottom-space { width: 10px; height: 100px; }
  .field {
    width: 260px;
    height: 56px;
    margin-bottom: 8px;
    border-radius: 28px;
    background-color: #1e1e2c;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
  }
  .query {
    width: 228px;
    font-size: 26px;
    color: #ffffff;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }
  .hint { width: 228px; font-size: 24px; color: #707088; text-align: center; }
  .keys { width: 466px; display: flex; flex-direction: column; align-items: center; }
  .key-row {
    height: 58px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }
  .key {
    width: 46px;
    height: 52px;
    margin: 0 3px;
    border-radius: 12px;
    background-color: #26263a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .key-text { font-size: 28px; color: #ffffff; }
  .wide-key {
    width: 74px;
    height: 52px;
    margin: 0 3px;
    border-radius: 14px;
    background-color: #33334a;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .toggle-key { background-color: #0f3a52; }
  .wide-text { font-size: 20px; color: #ffffff; }
  .go {
    width: 220px;
    height: 58px;
    margin-top: 8px;
    border-radius: 29px;
    background-color: #62c8ff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .go-text { font-size: 26px; color: #06202e; }
  .count { width: 300px; margin-top: 10px; font-size: 22px; color: #62c8ff; text-align: center; }
  .slot { width: 370px; height: 108px; margin-top: 8px; }
  .row {
    width: 370px;
    height: 108px;
    border-radius: 20px;
    background-color: #16161f;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .label {
    width: 336px;
    font-size: 24px;
    color: #ffffff;
    text-align: left;
    max-lines: 2;
    text-overflow: ellipsis;
  }
  .sub {
    width: 336px;
    font-size: 19px;
    color: #9a9ab0;
    text-align: center;
    max-lines: 1;
    text-overflow: ellipsis;
  }
</style>

<script>
  import router from '@system.router'
  import { nav } from '../lib/store.js'
  import { searchOne, searchAll } from '../lib/search.js'
  import { normalizeQuery } from '../lib/text.js'

  const MAX_LEN = 30

  // Hebrew rows are listed right to left and reversed for the left-to-right flex row.
  const LAYOUTS = {
    he: [
      ['א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז'],
      ['ח', 'ט', 'י', 'כ', 'ך', 'ל', 'מ'],
      ['ם', 'נ', 'ן', 'ס', 'ע', 'פ', 'ף'],
      ['צ', 'ץ', 'ק', 'ר', 'ש', 'ת']
    ],
    en: [
      ['a', 'b', 'c', 'd', 'e', 'f', 'g'],
      ['h', 'i', 'j', 'k', 'l', 'm', 'n'],
      ['o', 'p', 'q', 'r', 's', 't', 'u'],
      ['v', 'w', 'x', 'y', 'z']
    ],
    num: [
      ['1', '2', '3', '4', '5'],
      ['6', '7', '8', '9', '0']
    ]
  }
  const NEXT_LAYOUT = { he: 'en', en: 'num', num: 'he' }
  const TOGGLE_LABEL = { he: 'ABC', en: '123', num: 'אבג' }

  function rowsFor(name) {
    return LAYOUTS[name].map(keys => ({ keys: name === 'he' ? keys.slice().reverse() : keys }))
  }

  export default {
    data: {
      query: '',
      hint: 'חיפוש',
      keyRows: rowsFor('he'),
      toggleText: TOGGLE_LABEL.he,
      keys: true,
      editText: 'עצור',
      countText: '',
      results: []
    },
    layout: 'he',
    scope: 'all',
    hits: [],
    job: null,
    onInit() {
      this.scope = nav.searchScope
      this.hint = this.scope === 'file' ? 'חיפוש בקובץ' : 'חיפוש בהכל'
    },
    onHide() {
      if (this.job) this.job.cancelled = true
    },
    press(ch) {
      if (this.query.length >= MAX_LEN) return
      if (ch === ' ' && (!this.query || this.query.charAt(this.query.length - 1) === ' ')) return
      this.query = this.query + ch
    },
    backspace() {
      this.query = this.query.slice(0, -1)
    },
    clear() {
      this.query = ''
    },
    switchLayout() {
      this.layout = NEXT_LAYOUT[this.layout]
      this.keyRows = rowsFor(this.layout)
      this.toggleText = TOGGLE_LABEL[this.layout]
    },
    stopOrEdit() {
      if (this.job) this.job.cancelled = true
      else this.keys = true
    },
    async run() {
      if (this.job) return
      if (normalizeQuery(this.query).length < 2) {
        this.countText = 'הקלד לפחות שתי אותיות'
        return
      }
      this.keys = false
      this.editText = 'עצור'
      this.hits = []
      this.results = []
      this.countText = 'מחפש...'
      let fileName = ''
      let lastDraw = 0
      const job = {
        cancelled: false,
        onFile: name => { fileName = name },
        onHit: hit => {
          const i = this.hits.length
          this.hits.push(hit)
          const name = hit.path.slice(hit.path.lastIndexOf('/') + 1).replace(/\.[^.]+$/, '')
          this.results = this.results.concat([{ i: i, text: hit.text, name: name }])
        },
        onProgress: percent => {
          const now = Date.now()
          if (now - lastDraw < 300 || job.cancelled) return
          lastDraw = now
          this.countText = 'מחפש ' + (fileName ? fileName + ' ' : '') + percent + '%'
        }
      }
      this.job = job
      let capped = false
      let failed = false
      try {
        capped = this.scope === 'file' ? await searchOne(nav.path, this.query, job) : await searchAll(this.query, job)
      } catch (e) {
        failed = true
        console.info('[reader] search failed: ' + e)
      }
      this.job = null
      this.editText = 'חיפוש חדש'
      const n = this.hits.length
      this.countText = failed ? 'החיפוש נכשל'
        : (n ? 'תוצאות: ' + n : 'אין תוצאות') + (capped ? ' (הראשונות)' : job.cancelled ? ' (נעצר)' : '')
    },
    tap(i) {
      const hit = this.hits[i]
      if (!hit) return
      if (this.job) this.job.cancelled = true
      const fromMenu = !!nav.path && this.scope === 'file'
      nav.path = hit.path
      nav.target = hit.offset
      nav.hit = hit
      if (fromMenu) router.back()
      else router.push({ uri: 'reader' })
    }
  }
</script>
